{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "azureUserName": {
      "type": "string"
    },
    "azurePassword": {
      "type": "securestring"
    },
    "ODLID": {
      "type": "string"
    },
    "DeploymentID": {
      "type": "string"
    },
    "adminUsername": {
      "type": "string"
    },
    "adminPassword": {
      "type": "securestring"
    },
    "trainerUserName": {
      "type": "string"
    },
    "trainerUserPassword": {
      "type": "string"
    },
    "ApplicationID": {
      "type": "string"
    },
    "SecretKey": {
      "type": "string"
    }
  },
  "variables": {
    "labScriptUrl": "https://iconsnedbank.blob.core.windows.net/pre-sales/bootstrap-01.sh",
    "appScriptUrl": "https://iconsnedbank.blob.core.windows.net/pre-sales/bootstrap-02.sh",
    "location": "[resourceGroup().location]",
    "vmSize": "Standard_D2as_v7",
    "quote": "'",
    "virtualNetworkName": "[concat('lab-vnet-', parameters('DeploymentID'))]",
    "labSubnetName": "lab-subnet",
    "labSubnetPrefix": "10.0.1.0/24",
    "appSubnetName": "app-subnet",
    "appSubnetPrefix": "10.0.2.0/24",
    "labSubnetRef": "[resourceId('Microsoft.Network/virtualNetworks/subnets', variables('virtualNetworkName'), variables('labSubnetName'))]",
    "appSubnetRef": "[resourceId('Microsoft.Network/virtualNetworks/subnets', variables('virtualNetworkName'), variables('appSubnetName'))]",
    "LabVMName": "[concat('labvm-', parameters('DeploymentID'))]",
    "labVmPrivateIp": "10.0.1.10",
    "labNicName": "[concat(variables('LabVMName'), '-nic')]",
    "labPipName": "[concat(variables('LabVMName'), '-pip')]",
    "labPipDnsName": "[concat('lab', parameters('DeploymentID'), 'vm', uniqueString(resourceGroup().id))]",
    "labNsgName": "[concat(variables('LabVMName'), '-nsg')]",
    "AppVMName": "[concat('appvm-', parameters('DeploymentID'))]",
    "appVmPrivateIp": "10.0.2.10",
    "appNicName": "[concat(variables('AppVMName'), '-nic')]",
    "appPipName": "[concat(variables('AppVMName'), '-pip')]",
    "appNsgName": "[concat(variables('AppVMName'), '-nsg')]",
    "routeTableName": "[concat('rt-app-', parameters('DeploymentID'))]",
    "decommissionedNvaIp": "10.0.254.4",
    "storageAccountName": "[concat('stapp', parameters('DeploymentID'))]",
    "storageContainerName": "reports"
  },
  "resources": [
    {
      "name": "[variables('labNsgName')]",
      "type": "Microsoft.Network/networkSecurityGroups",
      "apiVersion": "2023-04-01",
      "location": "[variables('location')]",
      "comments": "Jump host NSG. SSH only. The labs never touch this NSG, so the learner's route in is never at risk.",
      "properties": {
        "securityRules": [
          {
            "name": "default-allow-ssh",
            "properties": {
              "priority": 1000,
              "protocol": "Tcp",
              "access": "Allow",
              "direction": "Inbound",
              "sourceAddressPrefix": "*",
              "sourcePortRange": "*",
              "destinationAddressPrefix": "*",
              "destinationPortRange": "22"
            }
          }
        ]
      }
    },
    {
      "name": "[variables('appNsgName')]",
      "type": "Microsoft.Network/networkSecurityGroups",
      "apiVersion": "2023-04-01",
      "location": "[variables('location')]",
      "comments": "FAULT (Lab 1): Deny-HTTP-Inbound at 200 is evaluated before Allow-HTTP-From-LabSubnet at 300, so HTTP from the jump host is dropped. The learner moves the allow rule to priority 150. Do not reorder these here.",
      "properties": {
        "securityRules": [
          {
            "name": "Allow-SSH-From-LabSubnet",
            "properties": {
              "description": "Operations access from the jump host subnet",
              "priority": 100,
              "protocol": "Tcp",
              "access": "Allow",
              "direction": "Inbound",
              "sourceAddressPrefix": "[variables('labSubnetPrefix')]",
              "sourcePortRange": "*",
              "destinationAddressPrefix": "*",
              "destinationPortRange": "22"
            }
          },
          {
            "name": "Deny-HTTP-Inbound",
            "properties": {
              "description": "CHG-4472 hardening - block plain HTTP ahead of the WAF migration",
              "priority": 200,
              "protocol": "Tcp",
              "access": "Deny",
              "direction": "Inbound",
              "sourceAddressPrefix": "*",
              "sourcePortRange": "*",
              "destinationAddressPrefix": "*",
              "destinationPortRange": "80"
            }
          },
          {
            "name": "Allow-HTTP-From-LabSubnet",
            "properties": {
              "description": "Health checks from the jump host subnet",
              "priority": 300,
              "protocol": "Tcp",
              "access": "Allow",
              "direction": "Inbound",
              "sourceAddressPrefix": "[variables('labSubnetPrefix')]",
              "sourcePortRange": "*",
              "destinationAddressPrefix": "*",
              "destinationPortRange": "80"
            }
          }
        ]
      }
    },
    {
      "name": "[variables('routeTableName')]",
      "type": "Microsoft.Network/routeTables",
      "apiVersion": "2023-04-01",
      "location": "[variables('location')]",
      "comments": "FAULT (Lab 1): a leftover route sends traffic for the jump host subnet to a firewall appliance that no longer exists. Return traffic from appvm is black-holed, so even SSH (allowed by the NSG) times out. The learner deletes the route.",
      "properties": {
        "disableBgpRoutePropagation": false,
        "routes": [
          {
            "name": "to-lab-subnet-via-nva",
            "properties": {
              "addressPrefix": "[variables('labSubnetPrefix')]",
              "nextHopType": "VirtualAppliance",
              "nextHopIpAddress": "[variables('decommissionedNvaIp')]"
            }
          }
        ]
      }
    },
    {
      "name": "[variables('virtualNetworkName')]",
      "type": "Microsoft.Network/virtualNetworks",
      "apiVersion": "2023-04-01",
      "location": "[variables('location')]",
      "comments": "FAULT (Lab 2): app-subnet deliberately has NO Microsoft.Storage service endpoint. The learner adds it.",
      "dependsOn": [
        "[resourceId('Microsoft.Network/routeTables', variables('routeTableName'))]"
      ],
      "properties": {
        "addressSpace": {
          "addressPrefixes": [
            "10.0.0.0/16"
          ]
        },
        "subnets": [
          {
            "name": "[variables('labSubnetName')]",
            "properties": {
              "addressPrefix": "[variables('labSubnetPrefix')]"
            }
          },
          {
            "name": "[variables('appSubnetName')]",
            "properties": {
              "addressPrefix": "[variables('appSubnetPrefix')]",
              "routeTable": {
                "id": "[resourceId('Microsoft.Network/routeTables', variables('routeTableName'))]"
              }
            }
          }
        ]
      }
    },
    {
      "name": "[variables('labPipName')]",
      "type": "Microsoft.Network/publicIPAddresses",
      "apiVersion": "2023-04-01",
      "location": "[variables('location')]",
      "sku": {
        "name": "Standard"
      },
      "properties": {
        "publicIPAllocationMethod": "Static",
        "dnsSettings": {
          "domainNameLabel": "[variables('labPipDnsName')]"
        }
      }
    },
    {
      "name": "[variables('appPipName')]",
      "type": "Microsoft.Network/publicIPAddresses",
      "apiVersion": "2023-04-01",
      "location": "[variables('location')]",
      "comments": "Outbound only - lets bootstrap-02.sh install nginx. The app NSG admits nothing from the internet.",
      "sku": {
        "name": "Standard"
      },
      "properties": {
        "publicIPAllocationMethod": "Static"
      }
    },
    {
      "name": "[variables('labNicName')]",
      "type": "Microsoft.Network/networkInterfaces",
      "apiVersion": "2023-04-01",
      "location": "[variables('location')]",
      "dependsOn": [
        "[resourceId('Microsoft.Network/virtualNetworks', variables('virtualNetworkName'))]",
        "[resourceId('Microsoft.Network/publicIPAddresses', variables('labPipName'))]",
        "[resourceId('Microsoft.Network/networkSecurityGroups', variables('labNsgName'))]"
      ],
      "properties": {
        "ipConfigurations": [
          {
            "name": "ipconfig1",
            "properties": {
              "subnet": {
                "id": "[variables('labSubnetRef')]"
              },
              "privateIPAllocationMethod": "Static",
              "privateIPAddress": "[variables('labVmPrivateIp')]",
              "publicIPAddress": {
                "id": "[resourceId('Microsoft.Network/publicIPAddresses', variables('labPipName'))]"
              }
            }
          }
        ],
        "networkSecurityGroup": {
          "id": "[resourceId('Microsoft.Network/networkSecurityGroups', variables('labNsgName'))]"
        }
      }
    },
    {
      "name": "[variables('appNicName')]",
      "type": "Microsoft.Network/networkInterfaces",
      "apiVersion": "2023-04-01",
      "location": "[variables('location')]",
      "dependsOn": [
        "[resourceId('Microsoft.Network/virtualNetworks', variables('virtualNetworkName'))]",
        "[resourceId('Microsoft.Network/publicIPAddresses', variables('appPipName'))]",
        "[resourceId('Microsoft.Network/networkSecurityGroups', variables('appNsgName'))]"
      ],
      "properties": {
        "ipConfigurations": [
          {
            "name": "ipconfig1",
            "properties": {
              "subnet": {
                "id": "[variables('appSubnetRef')]"
              },
              "privateIPAllocationMethod": "Static",
              "privateIPAddress": "[variables('appVmPrivateIp')]",
              "publicIPAddress": {
                "id": "[resourceId('Microsoft.Network/publicIPAddresses', variables('appPipName'))]"
              }
            }
          }
        ],
        "networkSecurityGroup": {
          "id": "[resourceId('Microsoft.Network/networkSecurityGroups', variables('appNsgName'))]"
        }
      }
    },
    {
      "name": "[variables('storageAccountName')]",
      "type": "Microsoft.Storage/storageAccounts",
      "apiVersion": "2023-01-01",
      "location": "[variables('location')]",
      "comments": "FAULT (Lab 2): firewall is 'selected networks' with no network rules, so every request from appvm is rejected with AuthorizationFailure. Shared key access is disabled on purpose - the app must use its managed identity.",
      "sku": {
        "name": "Standard_LRS"
      },
      "kind": "StorageV2",
      "properties": {
        "accessTier": "Hot",
        "minimumTlsVersion": "TLS1_2",
        "supportsHttpsTrafficOnly": true,
        "allowBlobPublicAccess": false,
        "allowSharedKeyAccess": false,
        "publicNetworkAccess": "Enabled",
        "networkAcls": {
          "bypass": "AzureServices",
          "defaultAction": "Deny",
          "virtualNetworkRules": [],
          "ipRules": []
        }
      }
    },
    {
      "name": "[concat(variables('storageAccountName'), '/default/', variables('storageContainerName'))]",
      "type": "Microsoft.Storage/storageAccounts/blobServices/containers",
      "apiVersion": "2023-01-01",
      "dependsOn": [
        "[resourceId('Microsoft.Storage/storageAccounts', variables('storageAccountName'))]"
      ],
      "properties": {
        "publicAccess": "None"
      }
    },
    {
      "name": "[variables('LabVMName')]",
      "type": "Microsoft.Compute/virtualMachines",
      "apiVersion": "2023-03-01",
      "location": "[variables('location')]",
      "dependsOn": [
        "[resourceId('Microsoft.Network/networkInterfaces', variables('labNicName'))]"
      ],
      "properties": {
        "osProfile": {
          "computerName": "[variables('LabVMName')]",
          "adminUsername": "[parameters('adminUsername')]",
          "adminPassword": "[parameters('adminPassword')]",
          "linuxConfiguration": {
            "disablePasswordAuthentication": false
          }
        },
        "hardwareProfile": {
          "vmSize": "[variables('vmSize')]"
        },
        "storageProfile": {
          "imageReference": {
            "publisher": "Canonical",
            "offer": "0001-com-ubuntu-server-jammy",
            "sku": "22_04-lts-gen2",
            "version": "latest"
          },
          "osDisk": {
            "name": "[concat(variables('LabVMName'), '-osdisk')]",
            "createOption": "FromImage",
            "managedDisk": {
              "storageAccountType": "Standard_LRS"
            }
          },
          "dataDisks": []
        },
        "networkProfile": {
          "networkInterfaces": [
            {
              "id": "[resourceId('Microsoft.Network/networkInterfaces', variables('labNicName'))]"
            }
          ]
        }
      }
    },
    {
      "name": "[variables('AppVMName')]",
      "type": "Microsoft.Compute/virtualMachines",
      "apiVersion": "2023-03-01",
      "location": "[variables('location')]",
      "comments": "FAULT (Lab 2): deployed with NO managed identity. Do not add an identity block here - enabling it is the first step of Lab 2.",
      "dependsOn": [
        "[resourceId('Microsoft.Network/networkInterfaces', variables('appNicName'))]"
      ],
      "properties": {
        "osProfile": {
          "computerName": "[variables('AppVMName')]",
          "adminUsername": "[parameters('adminUsername')]",
          "adminPassword": "[parameters('adminPassword')]",
          "linuxConfiguration": {
            "disablePasswordAuthentication": false
          }
        },
        "hardwareProfile": {
          "vmSize": "[variables('vmSize')]"
        },
        "storageProfile": {
          "imageReference": {
            "publisher": "Canonical",
            "offer": "0001-com-ubuntu-server-jammy",
            "sku": "22_04-lts-gen2",
            "version": "latest"
          },
          "osDisk": {
            "name": "[concat(variables('AppVMName'), '-osdisk')]",
            "createOption": "FromImage",
            "managedDisk": {
              "storageAccountType": "Standard_LRS"
            }
          },
          "dataDisks": []
        },
        "networkProfile": {
          "networkInterfaces": [
            {
              "id": "[resourceId('Microsoft.Network/networkInterfaces', variables('appNicName'))]"
            }
          ]
        }
      }
    },
    {
      "name": "[concat(variables('AppVMName'), '/CustomScript')]",
      "type": "Microsoft.Compute/virtualMachines/extensions",
      "apiVersion": "2023-03-01",
      "location": "[variables('location')]",
      "dependsOn": [
        "[resourceId('Microsoft.Compute/virtualMachines', variables('AppVMName'))]",
        "[resourceId('Microsoft.Storage/storageAccounts/blobServices/containers', variables('storageAccountName'), 'default', variables('storageContainerName'))]"
      ],
      "properties": {
        "publisher": "Microsoft.Azure.Extensions",
        "type": "CustomScript",
        "typeHandlerVersion": "2.1",
        "autoUpgradeMinorVersion": true,
        "settings": {
          "fileUris": [
            "[variables('appScriptUrl')]"
          ]
        },
        "protectedSettings": {
          "commandToExecute": "[concat('bash bootstrap-02.sh', ' -d ', parameters('DeploymentID'), ' -s ', variables('storageAccountName'), ' -c ', variables('storageContainerName'))]"
        }
      }
    },
    {
      "name": "[concat(variables('LabVMName'), '/CustomScript')]",
      "type": "Microsoft.Compute/virtualMachines/extensions",
      "apiVersion": "2023-03-01",
      "location": "[variables('location')]",
      "dependsOn": [
        "[resourceId('Microsoft.Compute/virtualMachines', variables('LabVMName'))]",
        "[resourceId('Microsoft.Compute/virtualMachines/extensions', variables('AppVMName'), 'CustomScript')]"
      ],
      "properties": {
        "publisher": "Microsoft.Azure.Extensions",
        "type": "CustomScript",
        "typeHandlerVersion": "2.1",
        "autoUpgradeMinorVersion": true,
        "settings": {
          "fileUris": [
            "[variables('labScriptUrl')]"
          ]
        },
        "protectedSettings": {
          "commandToExecute": "[concat('bash bootstrap-01.sh', ' -d ', parameters('DeploymentID'), ' -u ', parameters('trainerUserName'), ' -p ', parameters('trainerUserPassword'), ' -g ', resourceGroup().name, ' -b ', subscription().subscriptionId, ' -t ', subscription().tenantId, ' -a ', parameters('ApplicationID'), ' -k ', variables('quote'), parameters('SecretKey'), variables('quote'), ' -s ', variables('storageAccountName'), ' -c ', variables('storageContainerName'), ' -v ', variables('virtualNetworkName'), ' -i ', variables('appVmPrivateIp'))]"
        }
      }
    }
  ],
  "outputs": {
    "ApplicationID": {
      "type": "string",
      "value": "[parameters('ApplicationID')]"
    },
    "SecretKey": {
      "type": "string",
      "value": "[parameters('SecretKey')]"
    },
    "TenantID": {
      "type": "string",
      "value": "[subscription().tenantId]"
    },
    "SubscriptionID": {
      "type": "string",
      "value": "[subscription().subscriptionId]"
    },
    "DeploymentID": {
      "type": "string",
      "value": "[parameters('DeploymentID')]"
    },
    "Resource Group Name": {
      "type": "string",
      "value": "[resourceGroup().name]"
    },
    "LabVM Admin Username": {
      "type": "string",
      "value": "[parameters('adminUsername')]"
    },
    "LabVM Admin Password": {
      "type": "string",
      "value": "[parameters('adminPassword')]"
    },
    "Trainer Username": {
      "type": "string",
      "value": "[parameters('trainerUserName')]"
    },
    "Trainer Password": {
      "type": "string",
      "value": "[parameters('trainerUserPassword')]"
    },
    "LabVM DNS Name": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.Network/publicIPAddresses', variables('labPipName'))).dnsSettings.fqdn]"
    },
    "LabVM SSH Command": {
      "type": "string",
      "value": "[concat('ssh ', parameters('adminUsername'), '@', reference(resourceId('Microsoft.Network/publicIPAddresses', variables('labPipName'))).dnsSettings.fqdn)]"
    },
    "App VM Name": {
      "type": "string",
      "value": "[variables('AppVMName')]"
    },
    "App VM Private IP": {
      "type": "string",
      "value": "[variables('appVmPrivateIp')]"
    },
    "Storage Account Name": {
      "type": "string",
      "value": "[variables('storageAccountName')]"
    },
    "Storage Container Name": {
      "type": "string",
      "value": "[variables('storageContainerName')]"
    },
    "location": {
      "type": "string",
      "value": "[variables('location')]"
    }
  }
}